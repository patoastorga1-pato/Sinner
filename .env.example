# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site origin used by email confirmation and password reset redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public percentage used by the Phase 2 reservation estimate. No payment is created.
NEXT_PUBLIC_SINNER_SERVICE_FEE_PERCENT=11

# Server-only local fallback. Set false after the Supabase migrations and seed are applied.
SINNER_USE_DEVELOPMENT_FIXTURES=false
